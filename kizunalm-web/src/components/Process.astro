---
import { process } from '../data/site';
---

<section id="proceso" class="process page" aria-labelledby="process-title">
  <div class="section-head">
    <h2 id="process-title">{process.title}</h2>
    <p>{process.lead}</p>
  </div>
  <div class="label tracking">
    <div class="track-head">
      <div class="label-field"><span>Seguimiento</span><strong class="data">KZ-TU-PROYECTO</strong></div>
      <div class="label-field right"><span>Destino</span><strong>Tu negocio, funcionando</strong></div>
    </div>
    <hr class="perforation" />
    <ol class="steps">
      {
        process.steps.map((step) => (
          <li class="step">
            <span class="dot" aria-hidden="true" />
            <span class="status data">{step.status}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process { padding-block: clamp(56px, 8vw, 112px); }
  .tracking { overflow: hidden; }
  .track-head { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 18px clamp(20px, 3vw, 40px); }
  .track-head strong { font-size: 15px; }
  .right { text-align: right; }

  .steps {
    --line-y: 48px;
    position: relative; list-style: none; margin: 0;
    padding: 28px clamp(20px, 3vw, 40px) 40px;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 32px);
  }
  /* Ruta: línea punteada de fondo y la línea violeta que avanza con el scroll. */
  .steps::before, .steps::after {
    content: ""; position: absolute; left: clamp(20px, 3vw, 40px); right: clamp(20px, 3vw, 40px); top: var(--line-y);
    height: 4px; border-radius: 2px;
  }
  .steps::before { background: repeating-linear-gradient(90deg, var(--rule) 0 10px, transparent 10px 18px); }
  .steps::after { background: var(--tape); transform-origin: left center; }

  .step { position: relative; display: grid; gap: 8px; align-content: start; padding-top: 44px; }
  .dot {
    position: absolute; top: 10px; left: 0; width: 26px; height: 26px; border-radius: 50%;
    background: var(--label); border: 4px solid var(--tape); z-index: 1;
  }
  /* El estado se imprime sobre la ruta, junto a su punto, no encima del título. */
  .status { position: absolute; top: 14px; left: 36px; padding: 0 8px; background: var(--label); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--tape); z-index: 1; }
  .step h3 { font-size: clamp(24px, 2.4vw, 32px); }
  .step p { font-size: 15px; color: var(--ink-2); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* En longhands a propósito: el minificador fusiona «animation» + «animation-timeline» en un shorthand inválido. */
      .steps::after, .dot { animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 30% cover 55%; }
      .steps::after { animation-name: route; }
      .dot { animation-name: reach; }
      .step:nth-child(2) .dot { animation-range: entry 40% cover 58%; }
      .step:nth-child(3) .dot { animation-range: entry 50% cover 61%; }
      .step:nth-child(4) .dot { animation-range: entry 60% cover 64%; }
    }
  }
  @keyframes route { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes reach { 0%, 70% { background: var(--label); } 100% { background: var(--tape); } }

  @media (max-width: 820px) {
    .steps { grid-template-columns: minmax(0, 1fr); padding-left: 64px; }
    .steps::before, .steps::after { left: 36px; right: auto; top: 36px; bottom: 48px; width: 4px; height: auto; }
    .steps::before { background: repeating-linear-gradient(180deg, var(--rule) 0 10px, transparent 10px 18px); }
    .steps::after { transform-origin: center top; }
    .step { padding-top: 30px; }
    .status { top: 0; left: 0; padding: 0; }
    .right { text-align: left; }
    .dot { left: -41px; top: -2px; }
    @keyframes route { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  }
</style>
